# Contact form email delivery (Resend — https://resend.com)
# Copy this file to `.env.local` for local dev, and set the same values
# in Vercel → Project → Settings → Environment Variables for production.

# Your Resend API key (starts with "re_"). Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form enquiries should be delivered (any inbox you can read).
CONTACT_TO_EMAIL=contact@tyrianadv.com

# The "from" address shown on delivered emails.
# Until tyrianadv.com is verified in Resend, leave this unset — it defaults to
# Resend's onboarding sender. Once verified, set e.g.:
# CONTACT_FROM_EMAIL=Tyrian Advisory <contact@tyrianadv.com>
CONTACT_FROM_EMAIL=
